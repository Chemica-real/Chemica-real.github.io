{% extends "base.html.j2" %}
{% block content %}
<section class="page-hero" aria-labelledby="page-title">
  <p class="kicker">{{ page.kicker }}</p>
  <h1 id="page-title">{{ article_title }}</h1>
  <p class="lead"><a class="text-link" href="{{ index_url }}">返回列表</a></p>
</section>

<section class="article-shell">
  <article class="markdown-body">
    {{ content | safe }}
  </article>
</section>

<nav class="article-pager" data-article-pager aria-label="上一篇和下一篇">
  {% if previous_doc %}
  <a class="pager-button" href="{{ previous_doc.url }}">
    <span>上一篇</span>
    <strong>{{ previous_doc.title }}</strong>
  </a>
  {% else %}
  <span class="pager-button is-disabled">
    <span>上一篇</span>
    <strong>没有上一篇</strong>
  </span>
  {% endif %}

  {% if next_doc %}
  <a class="pager-button" href="{{ next_doc.url }}">
    <span>下一篇</span>
    <strong>{{ next_doc.title }}</strong>
  </a>
  {% else %}
  <span class="pager-button is-disabled">
    <span>下一篇</span>
    <strong>没有下一篇</strong>
  </span>
  {% endif %}
</nav>
{% endblock %}
